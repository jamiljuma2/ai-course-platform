# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# PayHero M-Pesa STK Push
PAYHERO_CHANNEL_ID=your_payhero_channel_id
PAYHERO_AUTH_TOKEN=base64(username:password)
# PAYHERO_USERNAME=your_payhero_username
# PAYHERO_PASSWORD=your_payhero_password
PAYHERO_API_URL=https://backend.payhero.co.ke/api/v2/payments
PAYHERO_CALLBACK_URL=https://your-project-ref.supabase.co/functions/v1/payhero-webhook?secret=replace_with_payhero_webhook_secret
PAYHERO_WEBHOOK_SECRET=replace_with_payhero_webhook_secret

# Email
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=NextGen Academy <noreply@yourdomain.com>
SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# Application
ADMIN_SECRET_KEY=replace_with_a_long_random_secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MEET_LINK=https://meet.google.com/your-meeting-code
